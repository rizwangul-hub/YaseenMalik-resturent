# ==================================================
# YASEEN MALAK RESTAURANT — PRODUCTION CONFIGURATION
# ==================================================

# Application Mode
NODE_ENV=production
PORT=5000

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# MongoDB Database URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/yaseen_malak_db

# Security & Authentication
JWT_SECRET=yaseen_malak_production_jwt_secret_key_change_me_in_prod
JWT_EXPIRE=30d

# Image Storage / Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration / SMTP (Optional for Order & Booking Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=Yaseen Malak Restaurant <noreply@yaseenmalakrestaurant.com>
